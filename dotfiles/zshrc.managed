# ==========================================================
# mac-bootstrap이 관리하는 zsh 설정
#
# 이 파일은 ~/.config/mac-bootstrap/zshrc로 복사되고,
# 기존 ~/.zshrc에서는 source 한 줄로 불러온다.
# ==========================================================

# 명령 기록을 여러 터미널에서 공유하고 중복을 줄인다.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS

# Terminal.app의 세션 저장/복원 메시지(Saving session..., Restored session: ...)를 끈다.
# SHARE_HISTORY를 쓰므로 Terminal의 세션별 명령 기록은 원래 사용하지 않는다.
if (( ${+functions[shell_session_update]} )); then
  add-zsh-hook -d zshexit shell_session_update
fi

# 자주 사용하는 Git 및 파일 목록 명령의 짧은 별칭이다.
alias gs="git status"
alias gl="git log --oneline --graph --decorate --all"
alias ll="ls -al"

# 강의장에서 자주 사용하는 화면 정리 및 Python 실행 명령이다.
alias c='clear'
alias py='python3'

# 계정 홈을 Nakta로 표시하고, 하위에서는 전체 경로를 이어서 표시한다.
mac_bootstrap_prompt_path() {
  if [[ "$PWD" == "$HOME" ]]; then
    print -nr -- 'Nakta'
  elif [[ "$PWD" == "$HOME"/* ]]; then
    print -nr -- "Nakta/${PWD#"$HOME"/}"
  else
    print -Pnr -- '%~'
  fi
}
setopt PROMPT_SUBST
PROMPT='%F{cyan}$(mac_bootstrap_prompt_path)%f %# '
